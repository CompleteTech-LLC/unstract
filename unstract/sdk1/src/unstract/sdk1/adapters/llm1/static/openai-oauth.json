{
  "title": "OpenAI OAuth LLM",
  "type": "object",
  "required": [
    "adapter_name",
    "model"
  ],
  "properties": {
    "adapter_name": {
      "type": "string",
      "title": "Name",
      "default": "",
      "description": "Provide a unique name for this adapter instance. Example: openai-chatgpt-personal"
    },
    "model": {
      "type": "string",
      "title": "Model",
      "enum": [
        "gpt-5.6-sol",
        "gpt-5.6-terra",
        "gpt-5.6-luna",
        "gpt-5.6",
        "gpt-5.3-codex",
        "gpt-5-codex"
      ],
      "enumNames": [
        "GPT-5.6 Sol (flagship)",
        "GPT-5.6 Terra (balanced)",
        "GPT-5.6 Luna (efficient)",
        "GPT-5.6 (default alias)",
        "GPT-5.3 Codex",
        "GPT-5 Codex (legacy)"
      ],
      "default": "gpt-5-codex",
      "description": "Choose the Codex-capable model to use through your ChatGPT account."
    },
    "max_tokens": {
      "type": "number",
      "minimum": 1,
      "multipleOf": 1,
      "title": "Maximum Output Tokens",
      "default": 4096,
      "description": "Maximum number of output tokens to request."
    },
    "max_retries": {
      "type": "number",
      "minimum": 0,
      "multipleOf": 1,
      "title": "Max Retries",
      "default": 5,
      "description": "The maximum number of times to retry a transient request."
    },
    "timeout": {
      "type": "number",
      "minimum": 0,
      "multipleOf": 1,
      "title": "Timeout",
      "default": 900,
      "description": "Timeout in seconds."
    },
    "enable_reasoning": {
      "type": "boolean",
      "title": "Enable Reasoning",
      "default": false,
      "description": "Allow the model to apply extra reasoning for complex tasks."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "enable_reasoning": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "reasoning_effort": {
            "type": "string",
            "enum": [
              "none",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "enumNames": [
              "None",
              "Low",
              "Medium",
              "High",
              "Extra high",
              "Maximum"
            ],
            "default": "medium",
            "title": "Reasoning Effort",
            "description": "Sets the reasoning strength when reasoning is enabled. Use None to minimize reasoning overhead."
          }
        },
        "required": [
          "reasoning_effort"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "enable_reasoning": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {}
      }
    }
  ]
}
